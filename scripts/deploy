#!/usr/bin/env sh

#
# Deploys an image to Nomad.
#
# Usage:
#
# ```
# NOMAD_ADDR=https://{{nomad-address}} IMAGE_TAG={{ Image tag in the registry }} ./deploy.sh
# ```
#

set -o errexit
set -o nounset

DRY_RUN=${DRY_RUN:-0}
IMAGE="${IMAGE:-"source.nathanhoule.net/ndhoule/personal-website"}"
IMAGE_TAG="${IMAGE_TAG:-}"

if [ -z "${IMAGE_TAG}" ]; then
	echo "IMAGE_TAG is missing. Aborting deployment."
	exit 1
fi

plan_output=$(
	NOMAD_ADDR="${NOMAD_ADDR}" NOMAD_TOKEN="${NOMAD_TOKEN}" nomad job plan \
		-var "image=${IMAGE}" \
		-var "image_tag=${IMAGE_TAG}" \
		.nomad/personal-website.nomad.hcl
) && plan_exit_code=$? || plan_exit_code=$?

if [ "${plan_exit_code}" = 255 ]; then
	echo "nomad plan failed. Aborting deployment."
	exit 1
fi

plan_check_index=$(echo "${plan_output}" | grep "Job Modify Index: " | sed "s/Job Modify Index: //" | xargs)

if [ -z "${plan_check_index}" ]; then
	echo "Could not extract check index from nomad plan. Aborting deployment."
	exit 1
fi

if [ "${DRY_RUN}" = 1 ] || [ "${DRY_RUN}" = "true" ]; then
	exit 0
fi

NOMAD_ADDR="${NOMAD_ADDR}" NOMAD_TOKEN="${NOMAD_TOKEN}" nomad job run \
	-check-index "${plan_check_index}" \
	-var "image=${IMAGE}" \
	-var "image_tag=${IMAGE_TAG}" \
	.nomad/personal-website.nomad.hcl
