{
  "name": "nathanhoule.com",
  "private": true,
  "description": "Nathan Houle's personal website, found at nathanhoule.com.",
  "version": "0.0.0",
  "author": "Nathan Houle <nathan@nathanhoule.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ndhoule/nathanhoule.com.git"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">= 22.23.4"
  },
  "scripts": {
    "build": "astro build",
    "build-docker": "docker build -t ndhoule/nathanhoule.com:latest .",
    "check": "astro sync && vp check && astro check",
    "check:fix": "astro sync && vp check --fix",
    "clean": "rm -rf .astro/ *.tsbuildinfo",
    "deploy": "docker run --rm -v ./scripts:/data/scripts -v ./.nomad:/data/.nomad -w /data -e 'NOMAD_SKIP_VERIFY=1' -e \"NOMAD_ADDR=${NOMAD_ADDR}\" -e \"DRY_RUN=${DRY_RUN}\" -e \"IMAGE=${IMAGE}\" -e \"IMAGE_TAG=${IMAGE_TAG}\" --entrypoint /bin/sh hashicorp/nomad scripts/deploy",
    "dev": "astro dev",
    "distclean": "pnpm run clean && rm -rf dist/",
    "fmt": "vp fmt",
    "start": "node ./dist/server/entry.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/compiler-rs": "^0.5.2",
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@lukeed/ms": "^2.0.2",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tmcw/togeojson": "^7.1.3",
    "@tsconfig/strictest": "^2.0.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vis.gl/react-maplibre": "^8.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "astro": "^7.4.4",
    "maplibre-gl": "^6.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simplify-geojson": "^1.0.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite-plus": "catalog:",
    "zod": "^4.6.7"
  }
}
