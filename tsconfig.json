{
  "extends": ["astro/tsconfigs/strictest", "@tsconfig/strictest/tsconfig.json"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": [
    ".astro/types.d.ts",
    "astro.config.ts",
    "src/",
    "vite.config.ts",
    "src/**/.well-known/**/*"
  ],
  "exclude": ["dist/", "node_modules/"]
}
